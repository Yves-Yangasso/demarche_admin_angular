# ============================================================================
# Variables d'environnement - SunuDekk Admin (Angular SPA)
# ============================================================================
# Ces variables sont consommees au BUILD (par scripts/generate-env.mjs), pas
# au runtime. Une fois le SPA build, les valeurs sont figees dans les bundles
# JS servis par nginx.
#
# Usage :
#   - En local  : copier ce fichier en .env (gitignore) puis
#                 `docker compose --env-file .env up --build`
#   - Sur Dokploy : declarer les memes cles dans l'onglet Environment de
#                   l'application admin, puis Redeploy avec No Cache.
#
# Important : changer une valeur ici impose un REBUILD (pas un simple restart).
# ============================================================================

# URL absolue du backend Flask, sans trailing slash. L'apiBaseInterceptor
# prefixe cette base devant les URLs relatives `/api`, `/uploads`, `/socket.io`
# emises par HttpClient. Doit etre joignable depuis le navigateur de l'agent
# (pas depuis le conteneur), et autoriser le domaine admin dans son CORS
# (cote backend : variable FRONTEND_URLS).
API_BASE_URL=https://sunudekk-api.djazael.com
